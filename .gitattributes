# Line-ending normalization for text files.
* text=auto

# PHP-aware hunk headers in `git diff`.
*.php diff=php

# List-like manifests: concurrent additions to the same list merge instead of conflicting.
/composer.json merge=union

# Default: nothing goes into the dist archive. Re-include only what the installed package needs.
* export-ignore

# Manifest and top-level documentation.
/composer.json   -export-ignore
/LICENSE         -export-ignore
/README.md       -export-ignore
/CHANGELOG.md    -export-ignore

# Autoloaded source code, the `rr-worker` entry point and the default config
# that ServiceProvider merges and publishes.
/src             -export-ignore
/src/**          -export-ignore
/bin             -export-ignore
/bin/**          -export-ignore
/config          -export-ignore
/config/**       -export-ignore
