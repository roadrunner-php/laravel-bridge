parameters:
  level: 'max'
  paths:
    - bin/rr-worker
    - config
    - src
  reportUnmatchedIgnoredErrors: false
  ignoreErrors:
    - message: '#Call to protected method bootstrappers\(\) of class.+Kernel#'
      paths: [src/Application/Factory.php]
    - message: '#Class Spatie\\.+Ignition.* not found#'
      paths: [src/Listeners/ResetLaravelIgnitionListener.php]

    # symfony/console < 7.4 has no addCommand(), 8.0 has no add(): both branches are needed.
    - identifier: function.alreadyNarrowedType
      path: bin/rr-worker
    - identifier: method.notFound
      message: '#Application::add\(\)#'
      path: bin/rr-worker

    # The public constructor takes the Application contract; Job::$container is documented as the concrete
    # Container. Narrowing the parameter would break BC.
    - identifier: assign.propertyType
      message: '#Job::\$container#'
      path: src/Queue/RoadRunnerJob.php

    # Laravel's own queues pass a nullable queue name to createPayload() as well.
    - identifier: argument.type
      message: '#createPayload\(\) expects string, string\|null given#'
      path: src/Queue/RoadRunnerQueue.php

    # Store::put() documents int seconds, RoadRunner KV takes null as "no expiration".
    - identifier: argument.type
      message: '#put\(\) expects int, null given#'
      path: src/Cache/RoadRunnerStore.php

    # Temporary: the code below is wrong and is fixed by separate bug fix PRs.
    # increment()/decrement() store a negative TTL (see bug fix PR).
    - identifier: return.unusedType
      path: src/Cache/RoadRunnerStore.php
    - identifier: binaryOp.invalid
      path: src/Cache/RoadRunnerStore.php
    - identifier: cast.int
      path: src/Cache/RoadRunnerStore.php
    - identifier: argument.type
      message: '#getTtl\(\)|put\(\) expects int, \(DateInterval#'
      path: src/Cache/RoadRunnerStore.php
    # The default of 10 max tries is never applied, fixed by #187.
    - identifier: nullCoalesce.expr
      path: src/Queue/QueueWorker.php
    # An array backoff is cast to "Array", fixed by #188.
    - identifier: function.alreadyNarrowedType
      path: src/Queue/QueueWorker.php
    - identifier: argument.type
      message: '#explode expects string, mixed given#'
      path: src/Queue/QueueWorker.php
    - identifier: cast.string
      path: src/Queue/QueueWorker.php
    - identifier: cast.int
      path: src/Queue/QueueWorker.php
    # `$this->cache` is read before start() initializes it only in unit-level calls of process() (see bug fix PR).
    - identifier: booleanNot.alwaysFalse
      path: src/Queue/QueueWorker.php
    # A payload that is not a JSON object throws a TypeError (see bug fix PR).
    - identifier: assign.propertyType
      message: '#RoadRunnerJob::\$payload#'
      path: src/Queue/RoadRunnerJob.php
    - identifier: nullCoalesce.initializedProperty
      path: src/Queue/RoadRunnerJob.php
    # release() passes DateTime/DateInterval and negative delays to withDelay() (see bug fix PR).
    - identifier: argument.type
      message: '#withDelay\(\) expects int<0, max>, int given#'
      paths: [src/Queue/RoadRunnerJob.php, src/Queue/RoadRunnerQueue.php]
    # failed(null) calls getMessage() on null (see bug fix PR).
    - identifier: method.nonObject
      path: src/Queue/RoadRunnerJob.php
    # An activity exception is swallowed: TaskExceptionResult has no `result` (see bug fix PR).
    - identifier: property.nonObject
      path: src/Temporal/Interceptor/HandleActivityInterceptor.php
    # Declarations are validated by ReflectionClass in DeclarationRegistry.
    - identifier: return.type
      message: '#getDeclarations\(\)#'
      path: src/Temporal/Config/TemporalConfig.php
